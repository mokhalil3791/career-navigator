{
  "title": "Requirements extracted from one advert",
  "type": "object",
  "required": [
    "requirements"
  ],
  "properties": {
    "requirements": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "text",
          "kind"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "kind": {
            "type": "string",
            "enum": [
              "must",
              "nice"
            ]
          }
        }
      }
    },
    "hours": {
      "type": "string",
      "maxLength": 200
    },
    "location": {
      "type": "string",
      "maxLength": 200
    },
    "dutch": {
      "type": "object",
      "properties": {
        "demand": {
          "type": "string",
          "enum": [
            "required",
            "plus",
            "not-stated"
          ]
        },
        "level": {
          "type": "string",
          "enum": [
            "",
            "A1",
            "A2",
            "B1",
            "B2",
            "C1",
            "C2",
            "native"
          ]
        }
      }
    }
  }
}
