{
  "name": "career-navigator",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Free, open-source, browser-only career workspace for newcomers to the Dutch job market.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:site": "node scripts/build-site.mjs",
    "build:qr": "node scripts/build-qr.mjs",
    "build:all": "vite build && node scripts/build-site.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "e2e": "playwright test",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "qrcode": "1.5.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.86",
    "lit-html": "3.3.3",
    "pdfjs-dist": "6.4.299"
  }
}
