{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Events and local opportunities (content/events.json)",
  "description": "Coaches can edit this file without touching code. Events whose end date (or date) has passed are hidden automatically.",
  "type": "object",
  "required": [
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "$comment": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "date"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "date": {
            "type": "string",
            "maxLength": 10,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "endDate": {
            "type": "string",
            "maxLength": 10,
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "place": {
            "type": "string",
            "maxLength": 200
          },
          "online": {
            "type": "boolean"
          },
          "organiser": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "url": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https://"
          },
          "cost": {
            "type": "string",
            "enum": [
              "free"
            ]
          }
        }
      }
    }
  }
}
