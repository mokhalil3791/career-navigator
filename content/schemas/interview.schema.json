{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interview question pack (content/interview/<pack>.json)",
  "type": "object",
  "required": [
    "id",
    "title",
    "questions"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9_-]{2,64}$"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "roles": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 64
      }
    },
    "author": {
      "type": "string",
      "maxLength": 200
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question",
          "tip"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "question": {
            "type": "string",
            "maxLength": 500
          },
          "tip": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    }
  }
}
