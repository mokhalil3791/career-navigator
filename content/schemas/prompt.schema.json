{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Prompt frontmatter (content/prompts/<id>.md)",
  "description": "The safeguard block is added by code and cannot be removed by a template.",
  "type": "object",
  "required": [
    "id",
    "slug",
    "order",
    "title",
    "summary",
    "pasteWith",
    "appearsOn",
    "lang"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9_-]+$"
    },
    "slug": {
      "type": "string",
      "maxLength": 12,
      "pattern": "^[a-z]{2,12}$"
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "workshopNumber": {
      "type": [
        "integer",
        "string"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 120
    },
    "summary": {
      "type": "string",
      "maxLength": 400
    },
    "pasteWith": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "appearsOn": {
      "type": "string",
      "maxLength": 40
    },
    "lang": {
      "type": "string",
      "maxLength": 12
    },
    "output": {
      "type": "string",
      "enum": [
        "text",
        "json"
      ]
    },
    "schema": {
      "type": "string",
      "maxLength": 64
    },
    "library": {
      "type": "boolean"
    }
  }
}
